# -----------------------------------------------------------------------------
# Environment-Specific Terraform Variables
#
# Runtime and environment-specific values are intentionally not stored here.
# They are expected to be supplied through HCP Terraform workspace or
# project-level variable sets.
#
# Examples:
#
# project_id    = "my-gcp-project"
# region        = "us-central1"
# kms_location  = "us-central1"
# key_ring_name = "platform-keyring"
# key_name      = "platform-key"
#
# labels = {
#   managed_by  = "terraform"
#   environment = "dev"
# }
# -----------------------------------------------------------------------------
